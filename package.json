{
  "name": "waveframe",
  "version": "2.3.0",
  "description": "Opsis Media Suite - audio enhancer, converter and video encoder (formerly Waveframe)",
  "main": "main.js",
  "author": "giorstergiopoulos-design",
  "homepage": "https://github.com/giorstergiopoulos-design/waveframe",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "smoke-test": "node smoke-test.js",
    "test": "node --test test/video.test.js test/video.real.test.js test/audiolib.test.js test/suite.test.js test/convert.test.js test/convert.real.test.js test/i18n.test.js test/security.test.js test/update-helper.test.js test/mpp-import.test.js test/photo.test.js test/videoplayer.test.js",
    "selftest": "node selftest.js"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "music-metadata": "^11.16.1"
  },
  "build": {
    "appId": "com.example.waveframe",
    "productName": "Opsis Media Suite",
    "copyright": "Copyright (c) 2026 giorstergiopoulos-design",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash-preload.js",
      "suite.js",
      "suite-main.js",
      "conv-engine.js",
      "conv-main.js",
      "conv-video.js",
      "media-main.js",
      "mpp-import.js",
      "suite-apps.json",
      "icon.ico",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "node_modules/music-metadata/**/*",
      "node_modules/@borewit/**/*",
      "node_modules/@tokenizer/**/*",
      "node_modules/content-type/**/*",
      "node_modules/debug/**/*",
      "node_modules/file-type/**/*",
      "node_modules/media-typer/**/*",
      "node_modules/strtok3/**/*",
      "node_modules/token-types/**/*",
      "node_modules/uint8array-extras/**/*",
      "node_modules/win-guid/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "description": "MP3 Audio File"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "description": "WAV Audio File"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio",
        "description": "FLAC Audio File"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio",
        "description": "OGG Vorbis Audio File"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio",
        "description": "AAC Audio File"
      },
      {
        "ext": "opus",
        "name": "Opus Audio",
        "description": "Opus Audio File"
      },
      {
        "ext": "wma",
        "name": "WMA Audio",
        "description": "WMA Audio File"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico",
      "artifactName": "OpsisMediaSuite-${version}.${ext}"
    }
  }
}
