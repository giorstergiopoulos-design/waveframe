{
  "name": "waveframe",
  "version": "1.5.0",
  "description": "Waveframe - real-time audio enhancer and player",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "smoke-test": "node smoke-test.js"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "music-metadata": "^11.16.1"
  },
  "build": {
    "appId": "com.example.waveframe",
    "productName": "Waveframe",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.ico",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "node_modules/music-metadata/**/*",
      "node_modules/@borewit/**/*",
      "node_modules/@tokenizer/**/*",
      "node_modules/content-type/**/*",
      "node_modules/debug/**/*",
      "node_modules/file-type/**/*",
      "node_modules/media-typer/**/*",
      "node_modules/strtok3/**/*",
      "node_modules/token-types/**/*",
      "node_modules/uint8array-extras/**/*",
      "node_modules/win-guid/**/*"
    ],
    "fileAssociations": [
      { "ext": "mp3", "name": "MP3 Audio", "description": "MP3 Audio File" },
      { "ext": "wav", "name": "WAV Audio", "description": "WAV Audio File" },
      { "ext": "flac", "name": "FLAC Audio", "description": "FLAC Audio File" },
      { "ext": "ogg", "name": "OGG Audio", "description": "OGG Vorbis Audio File" },
      { "ext": "m4a", "name": "M4A Audio", "description": "AAC Audio File" },
      { "ext": "opus", "name": "Opus Audio", "description": "Opus Audio File" },
      { "ext": "wma", "name": "WMA Audio", "description": "WMA Audio File" }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Waveframe",
      "multiLanguageInstaller": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
